    accent = Color3.fromRGB(110, 120, 255), off = Color3.fromRGB(70, 70, 84),
    text = Color3.fromRGB(235, 235, 245), sub = Color3.fromRGB(150, 150, 170),
}

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end
local function corner(o, r) new("UICorner", { CornerRadius = UDim.new(0, r) }, o) end

-- ScreenGui (fallback chain)
local gui = Instance.new("ScreenGui")
gui.Name = "ZpostUI"
gui.ResetOnSpawn = false
gui.DisplayOrder = 999
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
if protectgui then pcall(protectgui, gui) elseif syn and syn.protect_gui then pcall(syn.protect_gui, gui) end

local parented = false
for _, getP in ipairs({
    function() return gethui and gethui() end,
    function() return CoreGui end,
    function() return Players.LocalPlayer:WaitForChild("PlayerGui", 10) end,
}) do
    local ok, p = pcall(getP)
    if ok and p then
        pcall(function() gui.Parent = p end)
        if gui.Parent == p then parented = true break end
    end
end
if not parented then return warn("[zpost] gagal membuat GUI, tidak ada parent yang bisa dipakai") end
cleanup[#cleanup + 1] = function() gui:Destroy() end

-- drag + tap
local function makeDraggable(handle, target, onTap)
    local dragging, moved, startInput, startPos = false, false, nil, nil
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, moved = true, false
            startInput, startPos = input.Position, target.Position
            local c
            c = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    c:Disconnect()
                    if not moved and onTap then safe(onTap) end
                end
            end)
        end
    end))
    track(UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - startInput
            if d.Magnitude > 8 then moved = true end
            if moved then
                target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end))
end

