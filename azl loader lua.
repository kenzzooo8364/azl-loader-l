}, main)
new("UIListLayout", { Padding = UDim.new(0, 5) }, tabList)

local content = new("Frame", {
    Size = UDim2.fromOffset(W - 112, H - 42), Position = UDim2.fromOffset(106, 38), BackgroundTransparency = 1,
}, main)

-- UI object
local UI = { Tabs = {} }
local activeTab
local function setActive(tab)
    if activeTab then
        activeTab.page.Visible = false
        TweenService:Create(activeTab.btn, TweenInfo.new(0.15), { BackgroundColor3 = C.tab, TextColor3 = C.sub }):Play()
    end
    activeTab = tab
    tab.page.Visible = true
    TweenService:Create(tab.btn, TweenInfo.new(0.15), { BackgroundColor3 = C.accent, TextColor3 = Color3.new(1, 1, 1) }):Play()
end

function UI:AddTab(name)
    local btn = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.tab, Text = name, AutoButtonColor = false,
        Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.sub,
    }, tabList)
    corner(btn, 6)
    local page = new("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(), Visible = false,
    }, content)
    new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, page)
    new("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }, page)

    local tab = { btn = btn, page = page }

    function tab:AddLabel(text)
        return new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = text,
            TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham,
            TextSize = 12, TextColor3 = C.sub, TextWrapped = true,
        }, page)
    end

    function tab:AddButton(text, callback)
        local b = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = C.row, Text = text, AutoButtonColor = false,
            Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = C.text,
        }, page)
        corner(b, 6)
        track(b.Activated:Connect(function() if callback then safe(callback) end end))
        return b
    end

    function tab:AddToggle(text, default, callback)
        local state = default and true or false
        local row = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = C.row, Text = "", AutoButtonColor = false,
        }, page)
        corner(row, 6)
        new("TextLabel", {
            Size = UDim2.new(1, -64, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1,
            Text = text, TextXAlignment = Enum.TextXAlignment.Left, Font = Enum.Font.GothamMedium,
            TextSize = 13, TextColor3 = C.text,
        }, row)
        local sw = new("Frame", {
            Size = UDim2.fromOffset(38, 20), Position = UDim2.new(1, -48, 0.5, -10),
            BackgroundColor3 = state and C.accent or C.off,
        }, row)
        corner(sw, 10)
        local knob = new("Frame", {
            Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1),
            Position = state and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2),
        }, sw)
        corner(knob, 8)

        local obj = {}
        local function render()
            local ti = TweenInfo.new(0.15)
            TweenService:Create(sw, ti, { BackgroundColor3 = state and C.accent or C.off }):Play()
            TweenService:Create(knob, ti, { Position = state and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2) }):Play()
        end
        function obj:Set(v, silent)
            state = v and true or false
            render()
            if not silent and callback then safe(callback, state) end
        end
        function obj:Get() return state end
        track(row.Activated:Connect(function() obj:Set(not state) end))
        return obj
    end

    track(btn.Activated:Connect(function() setActive(tab) end))
    UI.Tabs[name] = tab
    if not activeTab then setActive(tab) end
    return tab
end

function UI.Unload()
    cleanupAll()
    genv.ZPOST_GUI = nil
end

-- tab
