-- ===== loader hub Azure Latch =====
local hubLoaded, loading = false, false
local function setStatus(t) pcall(function() statusLabel.Text = "Status hub: " .. t end) end

local function fetch(url)
    local ok, body = pcall(function() return game:HttpGet(url, true) end)
    if ok and type(body) == "string" and #body > 0 then return body end
    if req then
        local ok2, res = pcall(req, { Url = url, Method = "GET" })
        if ok2 and res and type(res.Body) == "string" and #res.Body > 0 then return res.Body end
    end
end

local function loadHub()
    if hubLoaded or loading then return end
    loading = true
    local function fail(msg)
        loading = false
        setStatus("gagal, " .. msg)
        warn("[zpost] " .. msg)
    end

    if type(loadstring) ~= "function" then return fail("executor tidak punya loadstring") end

    setStatus("menunggu game...")
    if not game:IsLoaded() then game.Loaded:Wait() end

    local pk = RS:FindFirstChild("packets") or RS:WaitForChild("packets", IS_MOBILE and 20 or 8)
    if not pk then return fail("'packets' tidak ketemu (bukan game yang benar / belum selesai loading)") end

    local gateOk = pcall(function()
        local res = require(pk)
        assert(type(res) == "table" and (rawget(res, "bytenet_use") or res.bytenet_use))
    end)
    if not gateOk then return fail("require() gagal / tidak ada bytenet_use, pakai executor UNC lebih tinggi") end

    if genv.AzlScriptLoaded or _G.AzlScriptLoaded then
        hubLoaded, loading = true, false
        return setStatus("sudah aktif (rejoin kalau mau muat ulang)")
    end

    setStatus("mengunduh script...")
    local src
    local tries = IS_MOBILE and 4 or 3
    for i = 1, tries do
        src = fetch(HUB_URL)
        if src then break end
        warn(("[zpost] fetch gagal %d/%d"):format(i, tries))
        task.wait(1 + math.random() * 0.5)
    end
    if not src then return fail("download gagal, cek koneksi / HTTP executor") end

    local fn, err = loadstring(src)
    if not fn then return fail("compile error: " .. tostring(err)) end

    setStatus("menjalankan hub...")
    local ok = safe(fn)
    if not ok then
        genv.AzlScriptLoaded = nil
        _G.AzlScriptLoaded = nil
        return fail("hub error, lihat console")
    end
    hubLoaded, loading = true, false
    setStatus("aktif")
end

tMain:AddButton("Muat Hub / Coba Lagi", function() task.spawn(loadHub) end)
tMain:AddLabel("Hub punya GUI sendiri. Tombol K hanya untuk GUI ini.")
task.spawn(loadHub)

warn("[zpost] GUI siap")
