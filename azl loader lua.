local cleanup = {}
local function safe(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then warn("[zpost-Q] " .. tostring(err)) end
    return ok, err
end
local function cleanupAll()
    for _, f in ipairs(cleanup) do safe(f) end
    cleanup = {}
end
local function track(conn)
    cleanup[#cleanup + 1] = function() conn:Disconnect() end
    return conn
end

local IS_MOBILE = UIS.TouchEnabled and not UIS.KeyboardEnabled
genv.ZPOST_MOBILE = IS_MOBILE
